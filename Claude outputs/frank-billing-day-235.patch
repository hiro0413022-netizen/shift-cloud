+    ["2026-09-02", "2026-09-04", "2026-11-10"],
+    ["2026-09-05", "2026-09-05", "2026-11-10"],
+    ["2026-09-11", "2026-11-02", "2027-01-10"], // 尾内様・大江様
+  ];
