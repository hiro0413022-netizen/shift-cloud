+        </div>
+      </div>
+
+      {/* 同意 */}
+      <div className={`${cardCls} space-y-3`}>
+        <p className="text-sm font-semibold text-(--color-txt)">ご確認・同意</p>
+        <label className="flex items-start gap-3 text-sm text-(--color-dim)">
